# ============================================
# TIDE-API v0.0.5 — ENVIRONMENT DEFAULTS
# ============================================
# Copy to tideapi.env to configure TIDE-API.
# Existing environment variables take precedence when running locally.
# PostgreSQL credentials remain in .env and postgres.env.

# --- Persistence ---
TIDEAPI_STORE_BACKEND=sqlite3  # sqlite3 or postgresql
TIDEAPI_PSQL_HOST=127.0.0.1  # Docker Compose sets this to postgres

# --- Optional path overrides ---
# Defaults use the TIDE-API directory; relative overrides use the working directory.
# TIDEAPI_BUNDLE_DIR=./bundles
# TIDEAPI_SQLITE_DB_PATH=./data/bundles.db

# --- Bundle loading ---
TIDEAPI_INCLUDE_BUNDLE_DIR_WHEN_LOADING=true

# --- PostgreSQL Testing ---
TIDEAPI_TEST_PSQL='0' # '1' enables PostgreSQL integration tests; requires `docker compose up -d postgres`