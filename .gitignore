# ==========================================
# TIDE-API .gitignore
# ==========================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.template
postgres.env

# Python tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
*.cover
*.py,cover
test-results*.xml

# Build and packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# SQLite databases and associated files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Local runtime bundles
# Keep example bundles and documentation
/data/*
!/data/.gitkeep
/bundles/*
!/bundles/example.json
!/bundles/.gitkeep
!/bundles/README.md

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*~

# Editor and IDE files
.vscode/
.idea/
.vs/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
